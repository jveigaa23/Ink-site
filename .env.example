# ---------------------------------------------------------------------------
# Variáveis de ambiente — copie para .env.local (desenvolvimento) e configure
# os mesmos nomes no painel da Vercel (produção). NUNCA versione valores reais.
# ---------------------------------------------------------------------------

# Banco PostgreSQL. Em produção (Neon), use a URL com pooler ("-pooler") aqui…
DATABASE_URL=postgres://usuario:senha@localhost:5432/studio_dev
# …e a URL direta (sem pooler) para migrações. Opcional em desenvolvimento.
DATABASE_URL_UNPOOLED=

# Segredo do servidor (mín. 32 caracteres). Gere com: openssl rand -hex 32
AUTH_SECRET=

# URL pública do site (links em e-mails, canonical, sitemap). Ex.: https://www.seuestudio.com.br
APP_URL=http://localhost:3000

# Vercel Blob — dois stores: um PÚBLICO (portfólio/site) e um PRIVADO (referências de clientes).
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=

# E-mail transacional (Resend). Sem estas duas, nada é enviado automaticamente:
# as mensagens ficam no painel para envio manual (WhatsApp/e-mail).
RESEND_API_KEY=
EMAIL_FROM=

# Segredo da rotina diária (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>"). Mín. 16 caracteres.
CRON_SECRET=

# Somente no build da Vercel: força migrações em deploys que não são de produção (evite).
# MIGRATE_ON_BUILD=1

# --- Somente para testes locais -------------------------------------------
# Banco usado pelos testes de integração (o nome DEVE conter "test"; é recriado a cada execução).
TEST_DATABASE_URL=postgres://usuario:senha@localhost:5432/studio_test
# Banco usado pelos testes E2E (o nome DEVE conter "e2e"; é recriado a cada execução).
E2E_DATABASE_URL=postgres://usuario:senha@localhost:5432/studio_e2e
